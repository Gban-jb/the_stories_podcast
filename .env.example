# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# Postgres. For a free instant dev database, run: npx create-db
# Then paste the connection string it prints here.
DATABASE_URL="postgresql://user:password@localhost:5432/stories?schema=public"

# The public origin, used for canonical URLs and social card links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# YouTube — the show's source of truth.
# Key:     console.cloud.google.com → enable "YouTube Data API v3" → create
#          an API key, and restrict it to that API.
# Channel: your channel id, starting with UC. Find it at
#          youtube.com/account_advanced
# Without both of these the site still runs; only syncing is unavailable.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# ---------------------------------------------------------------------------
# Admin at /admin. Unreachable until both are set.
# Generate the secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Lets a cron job POST /api/sync with an Authorization: Bearer header.
# Generate with: openssl rand -base64 32
SYNC_SECRET=""
